{
  "homepage": "https://Check-Tong.github.io/inventory",
  "name": "inventory-monorepo",
  "version": "1.0.0",
  "scripts": {
    "build": "npm --prefix frontend run build",
    "postbuild": "cp frontend/build/index.html frontend/build/404.html",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d frontend/build",
    "start": "npm run dev",
    "frontend": "npm --prefix frontend start",
    "backend": "npm --prefix backend start",
    "dev": "concurrently \"npm run frontend\" \"npm run backend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "gh-pages": "^6.3.0"
  }
}